{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:portal": "next dev -p 3000",
    "dev:admin": "pnpm --prefix admin dev",
    "build": "prisma generate && next build",
    "build:portal": "prisma generate && next build",
    "build:admin": "pnpm --prefix admin run build",
    "build:all": "pnpm run build:portal && pnpm run build:admin",
    "start": "next start",
    "start:portal": "next start -p 3000",
    "start:admin": "pnpm --prefix admin start",
    "lint": "eslint",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "next-intl": "^4.14.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.33.4"
}
